# Gemini API key (https://aistudio.google.com/apikey) - free tier works
GOOGLE_API_KEY=your-api-key-here

# Gemini model with tool-calling support (Flash-Lite recommended for the free tier)
GEMINI_MODEL=gemini-3.5-flash-lite

# Where the agent/API can reach the simulated monitored service
SIMULATOR_URL=http://localhost:8001
